# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required: use a private random value of at least 32 characters.
SECRET_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/careeros_db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Use true with HTTPS in production. False is only for local HTTP development.
COOKIE_SECURE=false
ENABLE_SANDBOX_ATS=false
# Optional: account UUID returned by /api/v1/auth/me. Browser profiles and the
# existing vault are shared desktop resources, available only to this operator.
# DESKTOP_OPERATOR_USER_ID=your-account-uuid
GEMINI_API_KEY=

# Conversational tool runner. Keys remain server-side.
ASSISTANT_MODEL=gemini/gemini-3.5-flash
# Optional natural Indian female speech; device voice works without these.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
